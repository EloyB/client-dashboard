# Database (Postgres, see docker-compose.yml for local dev)
DATABASE_URL="postgresql://client_dashboard:client_dashboard@localhost:5437/client_dashboard"

# Separate database for integration tests (same local Postgres server, see docker/postgres-init)
TEST_DATABASE_URL="postgresql://client_dashboard:client_dashboard@localhost:5437/client_dashboard_test"

# Auth (Better Auth)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Object storage (Scaleway, S3-compatible)
SCALEWAY_ACCESS_KEY_ID=""
SCALEWAY_SECRET_ACCESS_KEY=""
SCALEWAY_BUCKET_NAME=""
SCALEWAY_REGION="fr-par"
SCALEWAY_ENDPOINT="https://s3.fr-par.scw.cloud"

# Email (transactional provider: Resend)
RESEND_API_KEY=""
EMAIL_FROM="Studio Swyft <no-reply@studioswyft.be>"
ADMIN_NOTIFICATION_EMAIL=""
